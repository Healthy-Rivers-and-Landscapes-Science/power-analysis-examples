# Redd Data
redd_data <- read.csv("2022_2024_redds_spawning_area_subsample_merged.csv") %>%
  mutate(site = ifelse(esc_year == 2024 & treatment == "Control" & site == "Lower Riverbend", "Upper Riverbend", site), ## fix this site
         site = tolower(site),
         site = str_replace_all(site, " ", ""),
         siteid = paste0(site,"_", sub_samp_id)) %>% # create site ID
  filter(species == "CHINOOK" & !is.na(sub_samp_area_m2)) # only keep chinook observations
redd_data1 <- redd_data %>% 
              group_by(esc_year, siteid, treatment, sub_samp_area_m2, survey_num) %>% 
              summarize(redd_count_by_survey = n(), .groups ="drop") # calculated redd count

# Site Data
site_data <- read.csv("2022_2024_subsample_poly_area.csv") 
site_data1 <- site_data %>%
              mutate(site = tolower(site),
                     site = str_replace_all(site, " ", ""),
                     siteid = paste0(site, "_", sub_id),
                     total_surveys = ifelse(esc_year ==2023, 4,5)) %>%
              uncount(total_surveys, .id = "survey_num")

# Merge data, add 0 redds for surveys with no redds
## This data set has individual rows for every survey at every site.
data_survey <- site_data1 %>% left_join(redd_data1 %>% select(siteid, esc_year, treatment, survey_num, redd_count_by_survey), 
                                        by = c("siteid", "esc_year", "treatment", "survey_num")) %>%
               mutate(redd_count_by_survey = ifelse(is.na(redd_count_by_survey), 0, redd_count_by_survey)) 

# This data set has individual rows for every site, Use this data for the analysis
data_site <- data_survey %>% group_by(esc_year, siteid, treatment, sub_area) %>% 
              summarize(total_surveys = max(survey_num),
                        redd_count_by_site = sum(redd_count_by_survey),
                        .groups = "drop") %>%
              mutate(total_area_surveyed = sub_area*total_surveys)
# assign density and location
data_site$density <- ifelse(data_site$total_area_surveyed == 0 & data_site$redd_count_by_site == 0, 0,
                            data_site$redd_count_by_site / data_site$total_area_surveyed)
data_site$location <- ifelse(grepl("riverbend", data_site$siteid, ignore.case = T), "Downstream", "Upstream" )





# Analysis -----
# The analysis is completed by year (2022, 2023, and 2024), location (Upstream, Downstream), and for peak timing by year.


## Escapement Year 2022 ------------------------------------------------------------
data_site22 <- data_site %>% filter(esc_year == 2022) # subset year of interest
control <- data_site22[data_site22$treatment == "Control", ] # control Data
treatment <- data_site22[data_site22$treatment != "Control", ] # treatment Data
n_sites <- seq(from = 2, to = 35, by = 2)  # number of samples for each treatment for each power analysis (n_sites will vary based on your data and how many sites you have to pull from. ) 
boot_itr <- 1000 # Number of bootstrap iterations

set.seed(2026)
res_2022 <- boot_func(control, treatment, n_sites, boot_itr) ## Warning about ties sometimes happens this is due to 0 densities being resampled multiple times. 
# These results show that we reach the power threshold when 25-30 sites per treatment are surveyed during a dry year.
# The Cohens D is large, meaning there's a great difference between the two group, minimal overlap between the groups.



